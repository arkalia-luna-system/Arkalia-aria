[bandit]
# Exclure les répertoires et fichiers lourds ou non pertinents pour l'analyse
exclude: tests,venv,.venv,arkalia_aria_venv,archive,backups,logs,dacc,mobile_app,metrics_reports,reports,deployments,docs,__pycache__,.git,.pytest_cache,htmlcov,build,dist,.mypy_cache,._*

# Cibler uniquement le code source principal
targets: core,health_connectors,metrics_collector,pain_tracking,pattern_analysis,prediction_engine,research_tools,devops_automation,audio_voice,cia_sync

# Ignorer certains tests/flagrants faux positifs déjà évalués
skips: B101,B105,B108,B311,B601,B603,B604,B605,B606,B607,B608,B609,B610

